#19750 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#19751 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#19752 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(2.E-07),#19749,
  'distance_accuracy_value','confusion accuracy');
#19753 = CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#19754,#19756);
#19754 = ( REPRESENTATION_RELATIONSHIP('','',#32,#10) 
REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#19755) 
SHAPE_REPRESENTATION_RELATIONSHIP() );
#19755 = ITEM_DEFINED_TRANSFORMATION('','',#11,#15);
