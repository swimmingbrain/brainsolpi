  #19757);
#19757 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('5','neck_back','',#5,#27,$);
#19758 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#29));
ENDSEC;
